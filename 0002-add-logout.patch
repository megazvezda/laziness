diff --git a/internal/telegram/commands.go b/internal/telegram/commands.go
index 9311daf..2ed6887 100644
--- a/internal/telegram/commands.go
+++ b/internal/telegram/commands.go
@@ -30,3 +30,23 @@ func (b *Bot) whoami(ctx context.Context, _ *bot.Bot, update *tgmodels.Update) {
 	}
 	b.reply(ctx, message.Chat.ID, fmt.Sprintf("Sleeping as: %s (%d)", record.FullName, record.MoodleUserID))
 }
+
+func (b *Bot) logout(ctx context.Context, _ *bot.Bot, update *tgmodels.Update) {
+	message := update.Message
+	if message.From == nil {
+		return
+	}
+	deleted, err := storage.DeleteSession(ctx, b.db, message.From.ID)
+	if err != nil {
+		if !errors.Is(err, context.Canceled) {
+			b.logger.ErrorContext(ctx, "Could not delete Moodle session", "error_kind", errorKind(err))
+			b.reply(ctx, message.Chat.ID, "Could not delete your session.")
+		}
+		return
+	}
+	if !deleted {
+		b.reply(ctx, message.Chat.ID, "No saved session. Use /auth in the group to start Moodle login.")
+		return
+	}
+	b.reply(ctx, message.Chat.ID, "Logged out. Your Moodle tokens were deleted.")
+}
diff --git a/storage/sqlite.go b/storage/sqlite.go
index 73015d7..a3a8d47 100644
--- a/storage/sqlite.go
+++ b/storage/sqlite.go
@@ -61,6 +61,27 @@ func RetrieveSession(ctx context.Context, db *sql.DB, telegramUserID int64) (mod
 	return record, nil
 }
 
+// DeleteSession removes the stored Moodle tokens for a Telegram user.
+// The returned bool reports whether a session existed.
+func DeleteSession(ctx context.Context, db *sql.DB, telegramUserID int64) (bool, error) {
+	if telegramUserID <= 0 {
+		return false, fmt.Errorf("delete session: Telegram user ID must be positive")
+	}
+
+	result, err := db.ExecContext(ctx, `
+		DELETE FROM moodle_sessions
+		WHERE telegram_user_id = ?
+	`, telegramUserID)
+	if err != nil {
+		return false, fmt.Errorf("delete Moodle session: %w", err)
+	}
+	deleted, err := result.RowsAffected()
+	if err != nil {
+		return false, fmt.Errorf("delete Moodle session: %w", err)
+	}
+	return deleted > 0, nil
+}
+
 func ListSessions(ctx context.Context, db *sql.DB) ([]models.DBRecord, error) {
 	rows, err := db.QueryContext(ctx, `
 		SELECT telegram_user_id, moodle_user_id, moodle_fullname, public_token, private_token
